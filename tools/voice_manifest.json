      "id": "ledger_herald_intro",
      "voice": "ledger_herald",
      "text": "Her hand slipped, knight. Voragis bought Elysia's soul from the fall, and made your life the receipt. Run fast... or your debt matures.",
      "output_file": "ledger_herald_intro.wav",
      "text_hash": "cb50fb9f54abb72a"
    },
    {
      "id": "evil_eye_bones",
      "voice": "evil_eye_watcher",
      "text": "Every skeleton you shatter was a debtor who gave up! Crack their bones, runner, clear out Voragis's trash!",
      "output_file": "evil_eye_bones.wav",
      "text_hash": null
    },
    {
      "id": "evil_eye_gatekeeper",
      "voice": "evil_eye_watcher",
      "text": "Skeleton dust won't pay your tab! The Gatekeeper ahead holds pure soul-gold. Rip it from his chest!",
      "output_file": "evil_eye_gatekeeper.wav",
      "text_hash": null
    },
    {
      "id": "moonstone_keeper_warning",
      "voice": "moonstone_keeper",
      "text": "The black flame cuts deep, Kaelen. Look inside: do you still remember Elysia's smile... or just the blood?",
      "output_file": "moonstone_keeper_warning.wav",
      "text_hash": null
    },
    {
      "id": "prologue_narration",
      "voice": "prologue_narrator",
      "text": "Her hand slipped. You let her fall. Death didn't take Elysia, a debt collector did. Borrow his black flame to tear her back. Run. Slay. But remember: each demon slash burns away the brother she loved.",
      "output_file": "prologue_narration.wav",
      "text_hash": null
    }
