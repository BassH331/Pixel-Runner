                "voice_line_id": ""
            }
        },
        {
            "id": "npc_broken_pilgrim",
            "distance": 800,
            "type": "npc",
            "params": {
                "npc_type": "generic",
                "title": "Broken Pilgrim",
                "text": "I came here looking for the man who died in the void. They say Andras offered him a second chance. I wonder sometimes if the man accepted.",
                "radius": 160,
                "sprite_dir": "assets/graphics/Wizard_NPC",
                "scale": 2.0,
                "dialogue": {
                    "default": "I came here looking for the man who died in the void. They say Andras offered him a second chance. I wonder sometimes if the man accepted.",
                    "corruption_variants": {
                        "low": "You look... untouched. Hold onto that. Tightly.",
                        "mid": "I can see it in your eyes. The same look he had. Please \u2014 turn back.",
                        "high": "You are already past the point he was at when I last saw him. I am sorry."
                    },
                    "relic_branch": {
                        "relic_id": "shattered_gauntlet",
                        "text": "You found the gauntlet. Then you know where this started. You know what he lost."
                    }
                }
            }
        },
        {
            "id": "lore_bone_cairn",
            "distance": 1500,
            "type": "ambient_lore",
            "params": {
                "text": "A small cairn of bones. Not a grave \u2014 an offering. Someone left this for Andras."
            }
        },
        {
            "id": 14,
            "distance": 2558,
            "type": "boss",
            "params": {
                "title": "Blood Zombie",
                "scale": 2.0,
                "health": 120.0,
                "tier": "boss",
                "sprite_dir": "assets/graphics/bloodZombie",
                "behaviour_map": {
                    "Attack1": "skip",
                    "Attack2": "attack",
                    "Death": "death",
                    "Idle": "idle",
                    "Move": "walk"
                }
            }
        },
        {
            "id": "npc_void_scribe",
            "distance": 2200,
            "type": "npc",
            "params": {
                "npc_type": "generic",
                "title": "Void Scribe",
                "text": "I record what Andras makes. Names, dates, fates. The ledger is never full. There is always room.",
                "radius": 160,
                "sprite_dir": "assets/graphics/Wizard_NPC",
                "scale": 2.0,
                "dialogue": {
                    "default": "I record what Andras makes. Names, dates, fates. The ledger is never full. There is always room.",
                    "corruption_variants": {
                        "low": "No entry for you yet. Keep it that way.",
                        "mid": "Your name is... pencilled in. Lightly. For now.",
                        "high": "I have been waiting for you. Your page is nearly ready."
                    },
                    "relic_branch": {
                        "relic_id": "hollowed_ledger_page",
                        "text": "You found a page. One of many. Did you read the names? Did you recognise any of them?"
                    }
                }
            }
        },
        {
            "id": 11,
            "distance": 3500,
            "type": "npc",
            "params": {
                "npc_type": "generic",
                "title": "Watcher of the Abyss",
                "text": "Every skeleton you shatter was a mortal who refused my gift and crumbled. Break their bones, runner\u2014prove you are worthy of the darkness!",
                "radius": 160,
                "sprite_dir": "assets/graphics/Evil Eye Beast For Itch/Idle",
                "scale": 2.0,
                "voice_line_id": "evil_eye_bones"
            }
        },
        {
            "id": "npc_candora_messenger",
            "distance": 4000,
            "type": "npc",
            "params": {
                "npc_type": "generic",
                "title": "Candora's Messenger",
                "text": "Candora sent me to find the runner before he is lost. I may be too late. I am rarely early.",
                "radius": 160,
                "sprite_dir": "assets/graphics/Wizard_NPC",
                "scale": 2.0,
                "dialogue": {
                    "default": "Candora sent me to find the runner before he is lost. I may be too late. I am rarely early.",
                    "corruption_variants": {
                        "low": "She still sees you. The light does not abandon the willing.",
                        "mid": "She grieves for what you are becoming. But she has not looked away.",
                        "high": "I cannot reach you now. The void is too thick. But Candora... she still tries."
                    },
                    "relic_branch": {
                        "relic_id": "candoras_tear",
                        "text": "You carry her tear. She wept for you specifically. Do you understand what that means?"
                    }
                }
            }
        },
        {
            "id": "lore_void_bloom",
            "distance": 3000,
            "type": "ambient_lore",
            "params": {
                "text": "A flower grows from a crack in the earth ahead \u2014 black petals, silver centre. It turns toward you as you pass."
            }
        },
        {
            "id": 12,
            "distance": 7000,
            "type": "npc",
            "params": {
                "npc_type": "generic",
                "title": "The Scythe's Hunger",
                "text": "Mere bone dust will not sate my hunger. The Gatekeeper ahead holds a concentrated mass of souls. Rip it from his chest!",
                "radius": 160,
                "sprite_dir": "assets/graphics/Evil Eye Beast For Itch/Idle",
                "scale": 2.0,
                "voice_line_id": "evil_eye_gatekeeper"
            }
        },
        {
            "id": 13,
            "distance": 10500,
            "type": "npc",
            "params": {
                "npc_type": "generic",
                "title": "The Moonstone Keeper",
                "text": "The dark flame cuts deep. Look inside: do you still remember who you were before you accepted my power, or just the blood?",
                "radius": 160,
                "sprite_dir": "assets/graphics/Moonstone_Keeper Eldermoon_Grove - By SUCART/Idle-MoonstoneKeeper-SUCART/No BG",
                "scale": 2.0,
                "voice_line_id": "moonstone_keeper_warning"
            }
        },
