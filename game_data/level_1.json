        {
            "id": "lore_scarred_wall",
            "distance": 400,
            "type": "ambient_lore",
            "params": {
                "text": "The wall ahead is scarred with a sigil you do not recognise \u2014 and yet your hand reaches toward it before you stop yourself."
            }
