                    "hurt": "hurt",
                    "idle": "idle",
                    "walk": "walk"
                }
            }
        },
        {
            "id": "lore_faded_mural",
            "distance": 5000,
            "type": "ambient_lore",
            "params": {
                "text": "A mural, half-collapsed. It shows a figure standing at a threshold. The figure's face has been scratched out."
            }
        },
        {
            "id": "npc_previous_runner",
            "distance": 6500,
            "type": "npc",
            "params": {
                "npc_type": "generic",
                "title": "The Previous Runner",
                "text": "I recognise that mark. I wore it once. I thought it made me stronger. I was right. I was also wrong.",
                "radius": 160,
                "sprite_dir": "assets/graphics/Ronin/spr_RoninIdle_strip8_frames",
                "scale": 2.0,
                "dialogue": {
                    "default": "I recognise that mark. I wore it once. I thought it made me stronger. I was right. I was also wrong.",
                    "corruption_variants": {
                        "low": "You fight it better than I did. That is either strength or stubbornness. Either may save you.",
                        "mid": "This is where I started losing myself. The mid-point. It does not feel like a point of no return. That is the trap.",
                        "high": "I cannot tell you apart from what I became. That frightens me more than Andras ever did."
                    },
                    "relic_branch": {
                        "relic_id": "amalgam_core",
                        "text": "You found the core. Then you know what Andras intended both of us to become. Run. Or don't. It may not matter now."
                    }
                }
            }
        },
        {
            "id": "lore_void_sound",
            "distance": 7500,
            "type": "ambient_lore",
            "params": {
                "text": "The world goes quiet. For three seconds, even your footsteps make no sound. Then it returns \u2014 louder than before."
            }
        },
